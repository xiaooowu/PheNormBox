# Self-contained synthetic data for the PheNormBox smoke test
#
# Adapted from `create_simulation_data()` in Hong, Nelson, and Williamson:
# https://github.com/Charl3456/PheNorm_public/blob/main/1_Helper_data_gen.R
# Paper: https://arxiv.org/abs/2604.09913
#
# CHANGE: only the simplest `nonrare_info` mechanism is retained here. Output
# names follow the lowercase data specification documented for the general
# PheNorm analysis.
here::i_am("Data/Smoke_test/01_generate_smoke_data.R")
set.seed(20261011)
n <- 1000L
# ORIGINAL MECHANISM: common prevalence with informative Poisson silver labels.
initial_probability <- pmin(pmax(rnorm(n, mean = 0.4, sd = 0.1), 0), 1)
outcome <- rbinom(n, 1, initial_probability)
icd_count <- rpois(n, ifelse(outcome == 1, 8, 2))
nlp_count <- rpois(n, ifelse(outcome == 1, 12, 3))
test_set <- integer(n)
test_set[sample.int(n, 200L)] <- 1L
# Predictors mirror the compact example in Generalizable_PheNorm_Analysis_README.md.
# Demographic variables are generated independently of the outcome, whereas the
# two CUI counts are informative but noisy NLP features.
age <- sample(18:90, n, replace = TRUE)
sex_female <- rbinom(n, 1, 0.52)
race <- sample(
c("asian", "black", "white"),
n,
replace = TRUE,
prob = c(0.15, 0.20, 0.65)
)
C0000001 <- rpois(n, ifelse(outcome == 1, 2.5, 0.5))
C0000002 <- rpois(n, ifelse(outcome == 1, 1.5, 0.25))
# Create the ID, chart-review indicator, outcome, utilization, weight, three
# silver standards, and all predictors from the documented compact example.
# Latent probability variables are intentionally omitted to prevent direct
# outcome-information leakage.
phenorm_smoke_data <- data.frame(
study_id = seq_len(n),
reviewed_col = test_set,
gold_outcome = outcome,
utilization = 1L,
sampling_weight = 1L,
silver_total_icd_nlp = icd_count + nlp_count,
silver_total_icd_mention = icd_count,
silver_total_nlp = nlp_count,
age = age,
sex_female = sex_female,
race_asian = as.integer(race == "asian"),
race_black = as.integer(race == "black"),
race_white = as.integer(race == "white"),
C0000001 = C0000001,
C0000002 = C0000002
)
# Validate the documented source-data naming and value requirements.
predictor_cols <- c(
"age", "sex_female",
"race_asian", "race_black", "race_white",
"c0000001", "c0000002"
)
model_cols <- c(
"reviewed_col", "utilization", "sampling_weight",
"silver_total_icd_nlp", "silver_total_icd_mention", "silver_total_nlp",
predictor_cols
)
stopifnot(
nrow(phenorm_smoke_data) == 1000L,
!anyDuplicated(names(phenorm_smoke_data)),
all(grepl("^[a-z][a-z0-9_]*$", names(phenorm_smoke_data))),
!anyDuplicated(phenorm_smoke_data$study_id),
!anyNA(phenorm_smoke_data$study_id),
identical(sort(unique(phenorm_smoke_data$reviewed_col)), 0:1),
sum(phenorm_smoke_data$reviewed_col) == 200L,
identical(sort(unique(phenorm_smoke_data$gold_outcome)), 0:1),
identical(
sort(unique(phenorm_smoke_data$gold_outcome[
phenorm_smoke_data$reviewed_col == 1L
])),
0:1
),
all(startsWith(names(phenorm_smoke_data)[6:8], "silver_")),
identical(names(phenorm_smoke_data)[9:15], predictor_cols),
all(phenorm_smoke_data$age >= 18 & phenorm_smoke_data$age <= 90),
all(phenorm_smoke_data$sex_female %in% 0:1),
all(rowSums(phenorm_smoke_data[c(
"race_asian", "race_black", "race_white"
)]) == 1L),
all(vapply(phenorm_smoke_data[model_cols], is.numeric, logical(1))),
!anyNA(phenorm_smoke_data[model_cols]),
all(is.finite(as.matrix(phenorm_smoke_data[model_cols]))),
all(as.matrix(phenorm_smoke_data[model_cols]) >= 0),
all(phenorm_smoke_data$sampling_weight > 0)
)
