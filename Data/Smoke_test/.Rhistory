!anyDuplicated(phenorm_smoke_data$study_id),
!anyNA(phenorm_smoke_data$study_id),
identical(sort(unique(phenorm_smoke_data$reviewed_col)), 0:1),
sum(phenorm_smoke_data$reviewed_col) == 200L,
identical(sort(unique(phenorm_smoke_data$gold_outcome)), 0:1),
identical(
sort(unique(phenorm_smoke_data$gold_outcome[
phenorm_smoke_data$reviewed_col == 1L
