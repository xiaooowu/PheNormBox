0:1
),
all(startsWith(names(phenorm_smoke_data)[6:8], "silver_")),
identical(names(phenorm_smoke_data)[9:15], predictor_cols),
all(phenorm_smoke_data$age >= 18 & phenorm_smoke_data$age <= 90),
all(phenorm_smoke_data$sex_female %in% 0:1),
all(rowSums(phenorm_smoke_data[c(
